/**
 * Sohizi Cloudflare service: MP3 trimming for captioning.
 *
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sohizi-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-06",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "sohizi-ai-dev",
    },
  ],
  "vars": {
    "MAX_MP3_BYTES": "20971520",
  },
  "env": {
    "dev": {
      "name": "sohizi-cloudflare-dev",
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "sohizi-ai-dev",
        },
      ],
      "vars": {
        "MAX_MP3_BYTES": "20971520",
      },
    },
    "prod": {
      "name": "sohizi-cloudflare-prod",
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "sohizi-ai-prod",
        },
      ],
      "vars": {
        "MAX_MP3_BYTES": "20971520",
      },
    },
  },
}
