/**
 * Sohizi Cloudflare service: MP3 trimming and YouTube iframe screenshots.
 *
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sohizi-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-06",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "YOUTUBE_BROWSER_POOL",
        "class_name": "YoutubeBrowserPool",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RemotionRenderContainer"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["RemotionRenderContainer"],
      "new_sqlite_classes": ["YoutubeBrowserPool"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "sohizi-ai-dev",
    },
  ],
  "vars": {
    "MAX_MP3_BYTES": "20971520",
    "YOUTUBE_SCREENSHOT_MAX_TABS": "10",
    "R2_PUBLIC_URL": "https://media-dev.sohizi.com",
  },
  "env": {
    "dev": {
      "name": "sohizi-cloudflare-dev",
      "browser": {
        "binding": "BROWSER",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "YOUTUBE_BROWSER_POOL",
            "class_name": "YoutubeBrowserPool",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["RemotionRenderContainer"],
        },
        {
          "tag": "v2",
          "deleted_classes": ["RemotionRenderContainer"],
          "new_sqlite_classes": ["YoutubeBrowserPool"],
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "sohizi-ai-dev",
        },
      ],
      "vars": {
        "MAX_MP3_BYTES": "20971520",
        "YOUTUBE_SCREENSHOT_MAX_TABS": "10",
        "R2_PUBLIC_URL": "https://media-dev.sohizi.com",
      },
    },
    "prod": {
      "name": "sohizi-cloudflare-prod",
      "browser": {
        "binding": "BROWSER",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "YOUTUBE_BROWSER_POOL",
            "class_name": "YoutubeBrowserPool",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["RemotionRenderContainer"],
        },
        {
          "tag": "v2",
          "deleted_classes": ["RemotionRenderContainer"],
          "new_sqlite_classes": ["YoutubeBrowserPool"],
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "sohizi-ai-prod",
        },
      ],
      "vars": {
        "MAX_MP3_BYTES": "20971520",
        "YOUTUBE_SCREENSHOT_MAX_TABS": "10",
        "R2_PUBLIC_URL": "https://cdn.sohizi.com",
      },
    },
  },
}
