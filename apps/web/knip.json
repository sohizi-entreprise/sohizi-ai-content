{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/router.tsx",
    "src/routes/**/*.{ts,tsx}",
    "src/lib/workers/diff-worker.ts",
    "src/lib/sse.ts",
    "src/**/*.{test,spec}.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/components/ai-elements/**"],
  "ignoreBinaries": ["eslint"],
  "ignoreDependencies": [
    "embla-carousel-react",
    "react-day-picker",
    "recharts",
    "vaul",
    "eventsource-parser"
  ],
  "exclude": [
    "exports",
    "nsExports",
    "types",
    "nsTypes",
    "enumMembers",
    "duplicates",
    "dependencies",
    "devDependencies",
    "unlisted",
    "unresolved"
  ]
}
