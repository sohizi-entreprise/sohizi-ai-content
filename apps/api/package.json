{
  "name": "@sohizi/api",
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:ci": "bun test src/features/command/resolve.test.ts src/features/capacity/lease-store.test.ts src/features/capacity/router.test.ts src/features/capacity/user-gate.test.ts src/features/capacity/classify.test.ts src/features/capacity/retry-after.test.ts src/lib/tavily-client.test.ts src/features/ai/llm/router.test.ts src/features/ai/llm/errors.test.ts src/features/video-editor/render-pricing.test.ts && bun test src/features/media-engine/submit-media.test.ts && bun test src/features/video-editor/tests/render-service.test.ts",
    "dev": "docker compose -f ../../docker/docker-compose-inngest.yaml up -d && bun run --watch src/entry.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "MIGRATIONS_FOLDER=./src/db/migrations bun run src/db/migrate.ts",
    "auth:generate": "npx auth@latest generate --config src/lib/auth.ts --output src/db/schema/auth.ts --yes",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:validate": "bun run src/catalog/validate.ts",
    "catalog:populate": "bun run src/catalog/populate.ts",
    "catalog:overwrite": "bun run src/catalog/overwrite.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@langfuse/vercel-ai-sdk": "^5.11.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@openrouter/sdk": "^0.12.79",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@polar-sh/better-auth": "^2.1.0",
    "@polar-sh/sdk": "^1.0.2",
    "@remotion/lambda-client": "4.0.459",
    "@sentry/bun": "11.1.0",
    "@sohizi/analytics": "workspace:*",
    "@toon-format/toon": "^2.1.0",
    "ai": "^7",
    "archiver": "^8.0.0",
    "better-auth": "^1.6.11",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.28",
    "gpt-tokenizer": "^3.4.0",
    "inngest": "^4.1.0",
    "ioredis": "^5.9.3",
    "music-metadata": "^11.12.3",
    "openai": "^6.37.0",
    "partial-json": "^0.1.7",
    "pg": "^8.16.3",
    "resend": "^6.12.3",
    "shell-quote": "^1.8.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@sohizi/eslint-config": "workspace:*",
    "eslint": "^9.37.0",
    "prettier": "^3.5.3",
    "@types/archiver": "^8.0.0",
    "@types/pg": "^8.16.0",
    "@types/shell-quote": "^1.7.5",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.8"
  },
  "module": "src/index.js"
}
