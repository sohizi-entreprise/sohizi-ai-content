{
  "name": "@sohizi/api",
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:ci": "bun test src/features/command/resolve.test.ts src/features/routing/tests/limiter.test.ts src/features/video-editor/tests/render-service.test.ts",
    "dev": "docker compose -f ../../docker/docker-compose-inngest.yaml up -d && bun run --watch src/index.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "auth:generate": "npx auth@latest generate --config src/lib/auth.ts --output src/db/schema/auth.ts --yes",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/openai": "^4",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@huggingface/transformers": "^4.1.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@openrouter/sdk": "^0.12.79",
    "@toon-format/toon": "^2.1.0",
    "ai": "^7",
    "archiver": "^8.0.0",
    "better-auth": "^1.6.11",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.28",
    "gpt-tokenizer": "^3.4.0",
    "inngest": "^4.1.0",
    "ioredis": "^5.9.3",
    "music-metadata": "^11.12.3",
    "openai": "^6.37.0",
    "pg": "^8.16.3",
    "resend": "^6.12.3",
    "shell-quote": "^1.8.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@sohizi/eslint-config": "workspace:*",
    "eslint": "^9.37.0",
    "prettier": "^3.5.3",
    "@types/archiver": "^8.0.0",
    "@types/pg": "^8.16.0",
    "@types/shell-quote": "^1.7.5",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.8"
  },
  "module": "src/index.js"
}
