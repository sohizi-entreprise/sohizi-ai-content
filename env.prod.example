# Copy into the GitHub Actions secret ENV_FILE (full file body).
# Compose interpolates these from the VPS .env next to compose.yml.
# Set GitHub Actions vars SENTRY_ORG, SENTRY_PROJECT_WEB, and SENTRY_PROJECT_SITE,
# plus the CI-only secret SENTRY_AUTH_TOKEN for source-map uploads.
# For local testing, set SENTRY_ENVIRONMENT=local and SENTRY_LOCAL_ENABLED=true
# in each app's local .env. Local telemetry is otherwise disabled.

# --- Infra (unprefixed) ---
DOMAIN=sohizi.net
INFRA_DOMAIN=sohizi.net
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_QUEUE_WORKERS=10
INNGEST_LOG_LEVEL=info
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
REDIS_MAXMEMORY=1gb
BACKUP_DB=sohizi_prod
BACKUP_INTERVAL_SECONDS=21600
CLEANUP_INTERVAL_SECONDS=3600
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_R2_RETENTION_DAYS=30
SENTRY_ENVIRONMENT=rc
SENTRY_LOCAL_ENABLED=false
SENTRY_RELEASE=

# --- API ---
API_SENTRY_DSN=
API_OPENAI_API_KEY=
API_R2_ACCESS_KEY_ID=
API_R2_SECRET_ACCESS_KEY=
API_R2_ENDPOINT=
API_R2_BUCKET_NAME=
API_R2_PUBLIC_URL=
API_BETTER_AUTH_SECRET=
API_BETTER_AUTH_URL=
API_GOOGLE_CLIENT_ID=
API_GOOGLE_CLIENT_SECRET=
API_RESEND_API_KEY=
API_EMAIL_FROM=
API_FRONTEND_URL=
API_CLOUDFLARE_WORKER_URL=
API_CLOUDFLARE_WORKER_TOKEN=
API_YOUTUBE_SCREENSHOT_MAX_TABS=10
API_RENDER_SERVICE_TOKEN=
API_RENDER_ALLOWED_MEDIA_HOSTS=
API_LUMEN_API_KEY=
API_OPENROUTER_API_KEY=
API_VERCEL_GATEWAY_API_KEY=
API_TRAVELY_API_KEY=
API_WAVESPEED_API_KEY=
API_POLAR_ACCESS_TOKEN=
API_POLAR_WEBHOOK_SECRET=
API_POLAR_ENVIRONMENT=production

# --- Web ---
WEB_SENTRY_DSN=
WEB_SITE_URL=
WEB_MEDIA_CDN_URL=
WEB_API_URL=http://api:3030

# --- Site ---
SITE_SENTRY_DSN=
SITE_APP_URL=

# --- Analytics (public project token; same project in all services) ---
POSTHOG_PROJECT=phc_replace_me
POSTHOG_API_HOST=https://eu.i.posthog.com
POSTHOG_API_VERSION=2026-05-30
